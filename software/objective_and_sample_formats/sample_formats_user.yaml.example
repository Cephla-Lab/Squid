# User sample-format geometry: sparse overrides of the shipped catalog, and
# complete custom formats. Copy to sample_formats_user.yaml and REMOVE the
# examples you do not need - values must come from vendor drawings or
# measurement, never estimated.
#
# Absent file == shipped catalog only. a1 positions are calibrated in the app
# (placement), not authored here.
version: 1

overrides:
  # Example: this lab's 24-well plates are Millipore (18.90 mm pitch), not the
  # shipped Corning value. Only the fields present are overridden.
  "24 well plate":
    well_spacing_mm: 18.90

custom_formats:
  # Example: an anisotropic chamber slide. Per-axis spacing/size and shape;
  # x multiplies the column index, y the row index.
  "ibidi 8 well":
    rows: 2
    cols: 4
    well_spacing_x_mm: 12.57
    well_spacing_y_mm: 11.50
    well_size_x_mm: 10.75
    well_size_y_mm: 9.40
    well_shape: rectangle
